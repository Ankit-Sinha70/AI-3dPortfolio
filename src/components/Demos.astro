---
interface Demo {
  title: string;
  description: string;
  tags: string[];
  status: string;
}

const demos: Demo[] = [
  {
    title: 'Aurora - Text-to-Image Playground',
    description: 'Type a prompt, get a generated image back from a hosted diffusion endpoint. Live inference, not a canned gallery.',
    tags: ['Diffusion', 'FastAPI', 'Inference'],
    status: 'Live demo coming soon',
  },
{
title: 'Echo - Voice Cloning Playground',
description: 'Type a line, pick a voice profile, and stream back synthesized speech from a hosted TTS endpoint. Low-latency, not a pre-rendered clip.',
tags: ['TTS', 'PyTorch', 'WebSockets'],
status: 'Live demo coming soon',
},
];
---
<section class="demos" id="demos">
    <h2 class="eyebrow">Live Demos</h2>
  <div class="grid">
    {demos.map((demo) => (
      <article class="card">
        <div class="preview" aria-hidden="true">
          <span class="preview-label">{demo.status}</span>
        </div>
        <h3>{demo.title}</h3>
        <p class="desc">{demo.description}</p>
        <ul class="tags">
          {demo.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .demos {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .preview {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 140px;
    border-radius: 4px;
    background: linear-gradient(135deg, rgba(94, 234, 212, 0.08), rgba(255, 217, 160, 0.06));
    border: 1px dashed rgba(244, 241, 255, 0.15);
  }

  .preview-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .card h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    margin: 0;
    color: var(--text);
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .demos {
      padding: 6rem 6vw;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

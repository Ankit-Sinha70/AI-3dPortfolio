---
interface Demo {
  title: string;
  description: string;
  tags: string[];
  href: string;
  cta: string;
}

const demos: Demo[] = [
  {
    title: 'AI Interview Simulator',
    description: 'Adaptive mock interviews with real-time difficulty scaling, webcam attention tracking, voice delivery scoring, and recruiter-grade reports.',
    tags: ['Next.js 16', 'MediaPipe', 'Recharts'],
    href: 'https://interview-simulator-psi.vercel.app',
    cta: 'Open live site',
  },
  {
    title: '3D Portfolio Website',
    description: 'An interactive Three.js portfolio with custom lighting, smooth camera controls, and scene transitions, scoring 90+ on Lighthouse performance.',
    tags: ['React.js', 'Three.js', 'Vite'],
    href: 'https://ankit-sinha70.github.io',
    cta: 'Open live site',
  },
];
---
<section class="demos" id="demos">
    <h2 class="eyebrow">Live Demos</h2>
  <div class="grid">
    {demos.map((demo) => (
      <article class="card">
        <a class="preview" href={demo.href} target="_blank" rel="noopener" aria-label={`${demo.cta}: ${demo.title} (opens in a new tab)`}>
          <span class="preview-label">{demo.cta} ↗</span>
        </a>
        <h3>{demo.title}</h3>
        <p class="desc">{demo.description}</p>
        <ul class="tags">
          {demo.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .demos {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .preview {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 140px;
    border-radius: 4px;
    background: linear-gradient(135deg, rgba(94, 234, 212, 0.08), rgba(255, 217, 160, 0.06));
    border: 1px solid rgba(94, 234, 212, 0.22);
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .preview:hover,
  .preview:focus-visible {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(94, 234, 212, 0.14), rgba(255, 217, 160, 0.08));
  }

  .preview-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .card h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    margin: 0;
    color: var(--text);
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .demos {
      padding: 6rem 6vw;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { projects } from '../data/projects.js';

// Client projects delivered at Brainerhub Solutions (newest first, as in projects.js).
const clientProjects = projects
  .filter((project) => project.role.includes('Brainerhub'))
  .map((project) => ({
    slug: project.slug,
    name: project.title.split(' — ')[0],
    period: project.period,
    description: project.description,
    tags: project.tags,
  }));

// Entries are taken from the resume.
const experience = [
  {
    marker: '2023',
    role: 'Brainerhub Solutions · Ahmedabad, Gujarat · Feb 2023 – Present',
    title: 'Full-Stack Engineer',
    points: [
      'Delivered production-grade full-stack applications for 5+ clients across restaurant, SaaS, financial analytics, and enterprise domains using React.js, Next.js, Angular, Node.js, and TypeScript.',
      'Optimized RESTful API integrations and payload handling, cutting average response time by 30%.',
      'Engineered 15+ reusable, accessible UI components with Tailwind CSS and ShadCN.',
      'Partnered with a cross-functional team of 8 designers, backend engineers, and product managers, shortening release cycles by 15%.',
      'Owned end-to-end delivery timelines for 5+ concurrent client engagements.',
    ],
    nested: true,
  },
  {
    marker: '2024',
    role: 'Brainerhub Solutions · Mar 2024',
    title: 'Reliable and Punctual in Project Deliveries',
    text: 'Recognized company-wide for consistent on-time delivery across 5+ client engagements, reducing release cycles by 15% through structured sprint planning, task automation, and proactive stakeholder communication.',
  },
  {
    marker: '2015',
    role: 'Giridih College, Vinoba Bhave University, Jharkhand · 2015 – 2018',
    title: 'Bachelor of Arts, English Honours',
    text: 'Self-taught engineer: completed structured React.js, Next.js, Angular, TypeScript, and Node.js coursework via Udemy and freeCodeCamp, applied across 5+ production-grade client and personal projects.',
  },
];
---
<section class="experience" id="experience">
  <div class="heading"><span class="eyebrow">04 / Experience</span><h2>Delivering<br /><em>since 2023.</em></h2><p class="hint">Scroll through the timeline.</p></div>
  <div class="timeline">
    {experience.map((item) => (
      <article class="item" data-experience-item>
        <div class="marker"><span>{item.marker}</span><i></i></div>
        <div class="body">
          <p class="role">{item.role}</p>
          <h3>{item.title}</h3>
          {item.text && <p class="text">{item.text}</p>}
          {item.points && <ul class="points">{item.points.map((point) => <li>{point}</li>)}</ul>}
          {item.nested && (
            <div class="nested" data-experience-nested>
              <p class="nested-label">Key client projects</p>
              <ol class="projects">
                {clientProjects.map((project, index) => (
                  <li class="project" style={`--i:${index}`}>
                    <span class="project-period">{project.period}</span>
                    <h4 class="project-title"><a href={`/work/${project.slug}/`}>{project.name} <span aria-hidden="true">→</span></a></h4>
                    <p class="project-desc">{project.description}</p>
                    <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experience {
    position: relative;
    padding: 10rem 8vw;
    display: grid;
    grid-template-columns: minmax(240px, 0.7fr) 1.3fr;
    gap: 6vw;
    /* the nested projects start 26px to the right before they slide in; clip so that never widens the page */
    overflow-x: clip;
  }

  .heading {
    position: sticky;
    top: 20vh;
    height: max-content;
  }

  .eyebrow,
  .role {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-size: 0.75rem;
  }

  .heading h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 0.95;
    margin: 1.5rem 0;
  }

  .heading em {
    color: var(--text-dim);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-top: 2rem;
  }

  .timeline {
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 2rem;
    top: 1rem;
    bottom: 1rem;
    width: 1px;
    background: linear-gradient(var(--accent), transparent);
  }

  .item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    min-height: 260px;
    position: relative;
  }

  .marker {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* the year sits to the left of the line so a four-digit label never runs into the dot */
  .marker span {
    position: absolute;
    right: calc(100% - 1.35rem);
    top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    text-align: right;
    white-space: nowrap;
  }

  .marker i {
    position: absolute;
    left: 1.72rem;
    top: 0.25rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 rgba(94, 234, 212, 0);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .body {
    padding: 0 0 5rem 2rem;
    transition: transform 0.35s ease;
  }

  .body h3 {
    font-family: var(--font-display);
    font-size: 2.3rem;
    font-weight: 300;
    margin: 0.35rem 0 0.8rem;
  }

  .body .role {
    margin: 0;
    color: var(--warm);
  }

  .text {
    max-width: 48ch;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 54ch;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 0.45rem;
    height: 1px;
    background: var(--accent);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    border: 1px solid rgba(244, 241, 255, 0.1);
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
  }

  .item.is-active .body {
    transform: translateX(8px);
  }

  .item.is-active .marker i {
    transform: scale(1.6);
    box-shadow: 0 0 18px 4px rgba(94, 234, 212, 0.28);
  }

  /* client projects nested under the employer: their own small timeline */
  .nested {
    margin-top: 2.75rem;
  }

  .nested-label {
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.9rem;
    margin: 0;
    padding: 0 0 0 1.35rem;
    list-style: none;
    border-left: 1px solid rgba(94, 234, 212, 0.28);
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 52ch;
  }

  .project::before {
    content: '';
    position: absolute;
    left: calc(-1.35rem - 3px);
    top: 0.45rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .project-period {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--warm);
  }

  .project-title {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .project-title a:hover,
  .project-title a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .project-desc {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* motion: the projects slide in one after another the first time their group is reached (set up by the script) */
  .timeline.js-nest .project {
    opacity: 0;
    transform: translateX(26px);
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 0.14s);
  }

  .timeline.js-nest .nested.is-seen .project {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 800px) {
    .experience {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 6rem 6vw;
    }

    .heading {
      position: relative;
      top: auto;
    }

    .timeline::before {
      left: 1.5rem;
    }

    .item {
      grid-template-columns: 3rem 1fr;
    }

    .marker i {
      left: 1.23rem;
    }

    .marker span {
      right: calc(100% - 0.9rem);
    }

    .body {
      padding-left: 1rem;
    }

    .body h3 {
      font-size: 1.9rem;
    }

    .project-title {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('.experience .timeline');
  const items = [...document.querySelectorAll<HTMLElement>('[data-experience-item]')];

  if (timeline && items.length && 'IntersectionObserver' in window) {
    // An entry is "active" while it crosses the middle band of the screen. (A visible-percentage threshold would
    // never trigger for the tall Brainerhub entry on a small screen.)
    const activeObserver = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.target.classList.toggle('is-active', entry.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px', threshold: 0 },
    );
    items.forEach((item) => activeObserver.observe(item));

    // The nested projects animate in once, and only when motion is allowed.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timeline.classList.add('js-nest');
      const seenObserver = new IntersectionObserver(
        (entries, observer) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-seen');
            observer.unobserve(entry.target);
          }),
        { rootMargin: '0px 0px -15% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-experience-nested]').forEach((nested) => seenObserver.observe(nested));
    }
  }
</script>

---
const links = [
  { href: '#work', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<nav class="nav" data-cinematic-nav>
  <a href="/" class="logo">Ankit</a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false">
    <span></span><span></span>
  </button>
  <div class="nav-drawer" id="site-navigation">
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href} data-nav-link={link.href.startsWith('#') ? link.href.slice(1) : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-cinematic-nav]');
  const navLinks = nav?.querySelectorAll('[data-nav-link]') ?? [];
  const menuToggle = nav?.querySelector('.menu-toggle');
  const drawer = nav?.querySelector('.nav-drawer');

  const closeMenu = () => {
    if (!drawer || !menuToggle) return;
    drawer.classList.remove('is-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', 'Open navigation');
  };

  if (menuToggle && drawer) {
    menuToggle.addEventListener('click', () => {
      const open = drawer.classList.toggle('is-open');
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    });
    drawer.addEventListener('click', (event) => {
      if (event.target.closest('a')) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  }

  if (navLinks.length) {
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.getAttribute('data-nav-link') || ''))
      .filter(Boolean);

    const setActive = (id) => {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === id;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const updateActiveSection = () => {
      const marker = window.innerHeight * 0.35;
      let active = sections[0];
      sections.forEach((section) => {
        if (section.getBoundingClientRect().top <= marker) active = section;
      });
      if (active?.id) setActive(active.id);
    };

    navLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.getAttribute('data-nav-link');
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    let ticking = false;
    const handleScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveSection();
        ticking = false;
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', updateActiveSection);
    window.addEventListener('load', updateActiveSection);
    updateActiveSection();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 8vw;
    mix-blend-mode: difference;
  }

  .logo { font-family: var(--font-mono); color: var(--text); text-decoration: none; font-size: .95rem; letter-spacing: .05em; }

  .links { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .links a { color: var(--text); text-decoration: none; font-family: var(--font-mono); font-size: .85rem; letter-spacing: .05em; position: relative; }
  .links a::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 0; height: 1px; background: var(--accent); transition: width .25s ease; }
  .links a:hover::after, .links a.is-active::after { width: 100%; }
  .links a.is-active { opacity: 1; }

  .menu-toggle { display: none; width: 42px; height: 42px; padding: .65rem; border: 1px solid rgba(244,241,255,.16); border-radius: 50%; background: rgba(7,9,15,.45); color: var(--text); cursor: pointer; }
  .menu-toggle span { display: block; width: 100%; height: 1px; margin: 5px 0; background: currentColor; transition: transform .2s ease, opacity .2s ease; }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3px) rotate(-45deg); }

  @media (max-width: 640px) {
    .nav { padding: 1rem 6vw; }
    .menu-toggle { display: block; position: relative; z-index: 2; }
    .nav-drawer { position: absolute; top: .75rem; right: 6vw; width: min(280px, calc(100vw - 12vw)); padding: 4.2rem 1rem 1rem; border: 1px solid rgba(244,241,255,.14); border-radius: 18px; background: rgba(7,9,15,.92); backdrop-filter: blur(22px); opacity: 0; transform: translateY(-10px) scale(.98); pointer-events: none; transition: opacity .2s ease, transform .2s ease; }
    .nav-drawer.is-open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    .links { flex-direction: column; gap: .2rem; }
    .links a { display: block; padding: .85rem .7rem; border-radius: 8px; font-size: .8rem; }
    .links a:hover { background: rgba(94,234,212,.05); }
    .links a::after { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span, .nav-drawer { transition: none; }
  }
</style>

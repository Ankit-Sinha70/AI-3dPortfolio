---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<nav class="nav">
  <a href="/" class="logo">Ankit</a>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 8vw;
    mix-blend-mode: difference;
  }

  .logo {
    font-family: var(--font-mono);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    position: relative;
  }

  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.25s ease;
  }

  .links a:hover::after {
    width: 100%;
  }

  @media (max-width: 640px) {
    .nav {
      padding: 1.25rem 6vw;
    }
    .links {
      gap: 1.25rem;
    }
  }
</style>

---
const links = [
  { href: '#work', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<nav class="nav" data-cinematic-nav>
  <a href="/" class="logo">Ankit</a>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a href={link.href} data-nav-link={link.href.startsWith('#') ? link.href.slice(1) : undefined}>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.querySelector('[data-cinematic-nav]');
  const navLinks = nav?.querySelectorAll('[data-nav-link]') ?? [];

  if (navLinks.length) {
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.getAttribute('data-nav-link') || ''))
      .filter(Boolean);

    const setActive = (id) => {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === id;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const updateActiveSection = () => {
      const marker = window.innerHeight * 0.35;
      let active = sections[0];

      sections.forEach((section) => {
        if (section.getBoundingClientRect().top <= marker) active = section;
      });

      if (active?.id) setActive(active.id);
    };

    navLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.getAttribute('data-nav-link');
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    let ticking = false;
    const handleScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveSection();
        ticking = false;
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', updateActiveSection);
    window.addEventListener('load', updateActiveSection);
    updateActiveSection();
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 8vw;
    mix-blend-mode: difference;
  }

  .logo {
    font-family: var(--font-mono);
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    position: relative;
  }

  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.25s ease;
  }

  .links a:hover::after,
  .links a.is-active::after {
    width: 100%;
  }

  .links a.is-active {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .nav {
      padding: 1.25rem 6vw;
    }
    .links {
      gap: 1.25rem;
    }
  }
</style>

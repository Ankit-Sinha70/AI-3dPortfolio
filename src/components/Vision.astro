---
<section class="vision" id="vision">
  <svg class="vision-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle class="v-shape v-circle-outer" cx="200" cy="200" r="160" />
    <circle class="v-shape v-circle-inner" cx="200" cy="200" r="92" />
    <line class="v-shape v-line-a" x1="48" y1="48" x2="352" y2="352" />
    <line class="v-shape v-line-b" x1="352" y1="48" x2="48" y2="352" />
  </svg>
  <p class="vision-line">Every system I ship earns its place in production.</p>
</section>

<style>
  .vision {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 8vw;
    overflow: hidden;
  }

  .vision-svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    max-width: 560px;
    max-height: 560px;
  }

  .v-shape {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.55;
  }

  .vision-line {
    position: relative;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.3;
    color: var(--text);
    text-align: center;
    max-width: 18ch;
    margin: 0;
  }

  @media (max-width: 640px) {
    .vision {
      padding: 5rem 6vw;
      min-height: 55vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vision-line {
      opacity: 1;
    }
  }
</style>

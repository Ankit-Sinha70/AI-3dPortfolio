---
const entries = [
{ date: '2026-06', text: 'Started QISquare: Angular upgrade and SEC EDGAR pipeline fixes' },
{ date: '2026-05', text: 'Wrapped the IATF Solutions Toolbox and Solution to Share engagements' },
{ date: '2026-01', text: 'Began the IATF Solutions Toolbox Turborepo monorepo' },
{ date: '2025-06', text: 'Began Calendar Plus and File Manager for Solution to Share' },
{ date: '2024-03', text: 'Recognized for on-time delivery across 5+ client engagements' },
{ date: '2023-02', text: 'Joined Brainerhub Solutions as a Full-Stack Engineer' },
];
---

<section class="log" id="log">
<p class="log-eyebrow">Log</p>
<ul class="log-list">
{entries.map((entry) => (
<li class="log-entry">
<span class="log-date">{entry.date}</span>
<span class="log-text">{entry.text}</span>
</li>
))}
</ul>
</section>

<style>
.log {
position: relative;
padding: 6rem 8vw;
display: flex;
flex-direction: column;
gap: 1.5rem;
}

.log-eyebrow {
font-family: var(--font-mono);
color: var(--accent);
letter-spacing: 0.15em;
text-transform: uppercase;
font-size: 0.85rem;
margin: 0;
}

.log-list {
list-style: none;
margin: 0;
padding: 0;
display: flex;
flex-direction: column;
gap: 0.85rem;
max-width: 60ch;
}

.log-entry {
display: flex;
gap: 1.5rem;
font-family: var(--font-mono);
font-size: 0.9rem;
line-height: 1.5;
}

.log-date {
color: var(--text-dim);
flex-shrink: 0;
width: 5ch;
}

.log-text {
color: var(--text);
}

@media (max-width: 640px) {
.log {
padding: 4rem 6vw;
}

.log-entry {
flex-direction: column;
gap: 0.25rem;
}
}
</style>

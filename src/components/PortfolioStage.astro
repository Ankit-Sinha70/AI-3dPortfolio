---
import HeroCanvas from './HeroCanvas.tsx';
---

<div class="portfolio-stage" aria-hidden="true">
  <div class="stage-vignette"></div>
  <div class="stage-grid"></div>
  <div class="stage-camera">
    <HeroCanvas client:load />
  </div>
</div>

<style>
  .portfolio-stage { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; isolation: isolate; transition: opacity .8s ease, filter .8s ease; --scene-x:0%; --scene-y:0%; --scene-scale:1; --scene-rotate:0deg; --scene-opacity:1; }
  .stage-camera { position: absolute; inset: -9%; width: 118%; height: 118%; transform: translate3d(calc(4% + var(--scene-x)), calc(1% + var(--scene-y)), 0) scale(var(--scene-scale)) rotate(var(--scene-rotate)); transform-origin: 62% 46%; transition: transform 1.1s cubic-bezier(.22,.61,.36,1); will-change: transform; }
  .stage-camera :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; pointer-events: none; transition: filter .8s ease, opacity .8s ease; opacity: var(--scene-opacity); }
  .stage-grid, .stage-vignette { position: absolute; inset: 0; pointer-events: none; }
  .stage-grid { z-index:2; opacity:.12; background-image:linear-gradient(rgba(244,241,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(244,241,255,.04) 1px,transparent 1px); background-size:80px 80px; mask-image:radial-gradient(ellipse 75% 70% at 65% 48%,black 15%,transparent 88%); transform:perspective(900px) rotateX(62deg) translateY(18%); transform-origin:center bottom; transition:opacity .7s ease, transform 1.1s ease; }
  .stage-vignette { z-index:3; background:radial-gradient(circle at 62% 46%,transparent 0 28%,rgba(5,7,12,.16) 62%,rgba(5,7,12,.72) 100%),linear-gradient(180deg,rgba(5,7,12,.18),transparent 22%,transparent 78%,rgba(5,7,12,.5)); }
  :global(html.is-work-scene) .stage-camera :global(canvas) { filter: blur(5px) saturate(.78); opacity:.72; }
  :global(html.is-work-scene) .stage-grid { opacity:.08; }
  .portfolio-stage[data-chapter="work"] .stage-grid { opacity:.055; }
  .portfolio-stage[data-chapter="contact"] .stage-grid { opacity:.04; transform:perspective(900px) rotateX(62deg) translateY(22%) scale(1.04); }
  .portfolio-stage[data-chapter="log"] .stage-camera :global(canvas) { filter:saturate(.72); }
  @media (max-width:1200px) { .stage-camera { inset:-6%; width:112%; height:112%; transform:translate3d(calc(3% + var(--scene-x)),calc(1% + var(--scene-y)),0) scale(var(--scene-scale)) rotate(var(--scene-rotate)); } }
  @media (max-width:800px) {
    .stage-camera{inset:-2%;width:104%;height:104%;transform:translate3d(calc(1% + var(--scene-x) * .55),calc(var(--scene-y) * .55),0) scale(calc(1 + (var(--scene-scale) - 1) * .7)) rotate(var(--scene-rotate));transform-origin:58% 44%}
    .stage-grid{background-size:52px 52px;opacity:.06}
    .stage-vignette{background:radial-gradient(circle at 55% 42%,transparent 0 24%,rgba(5,7,12,.62) 92%)}
    :global(html.is-work-scene) .stage-camera :global(canvas){filter:blur(2px) saturate(.72);opacity:.62}
  }
  @media (max-width:480px) {
    .stage-camera{inset:0;width:100%;height:100%;transform:translate3d(var(--scene-x),var(--scene-y),0) scale(calc(1 + (var(--scene-scale) - 1) * .5))}
    .stage-grid{display:none}
  }
  @media (prefers-reduced-motion:reduce) { .stage-grid{transform:none}.portfolio-stage,.stage-camera,.stage-camera :global(canvas){transition:none}:global(html.is-work-scene) .stage-camera :global(canvas){filter:none} }
</style>

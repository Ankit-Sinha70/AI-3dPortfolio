---
const email = 'ar86748483@gmail.com';
---
<section class="contact" id="contact">
  <p class="eyebrow"><span class="section-counter" data-count="04">00</span>Contact</p>
  <h2>Let's build something that actually ships.</h2>
  <p class="subline">
    Open to roles and collaborations across generative AI — text, image, and audio systems.
  </p>
  <div class="actions">
    <a class="cta" href={`mailto:${email}`}>Say hello →</a>
    <a class="secondary" href="https://github.com/Ankit-Sinha70" target="_blank" rel="noopener">GitHub</a>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: 12rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0;
    max-width: 18ch;
    color: var(--text);
  }

  .subline {
    color: var(--text-dim);
    max-width: 40ch;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--bg);
    background: var(--accent);
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .cta:hover {
    background: var(--warm);
    transform: translateY(-2px);
  }

  .secondary {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    text-decoration: none;
    position: relative;
  }

  .secondary::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.25s ease;
  }

  .secondary:hover {
    color: var(--text);
  }

  .secondary:hover::after {
    width: 100%;
  }

  @media (max-width: 640px) {
    .contact {
      padding: 7rem 6vw;
      gap: 1.25rem;
    }
    .actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>

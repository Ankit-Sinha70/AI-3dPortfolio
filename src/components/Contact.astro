---
const email = 'araaj953@gmail.com';
---
<section class="contact" id="contact">
  <p class="eyebrow"><span class="section-counter" data-count="04">00</span>Contact</p>
  <h2>Get in touch.</h2>
  <p class="subline">
    Full-stack engineer based in Ahmedabad, Gujarat, India. Reach me by email or LinkedIn.
  </p>
  <p class="email-row">
    <a class="email" href={`mailto:${email}`}>{email}</a>
    <button type="button" class="copy" data-copy-email={email} aria-label="Copy email address">Copy</button>
    <span class="copy-status" role="status" aria-live="polite"></span>
  </p>
  <div class="actions">
    <a class="cta" href={`mailto:${email}`}>Say hello →</a>
    <a class="secondary" href="https://github.com/Ankit-Sinha70" target="_blank" rel="noopener">GitHub</a>
    <a class="secondary" href="https://www.linkedin.com/in/ankit-sinha-58702a204" target="_blank" rel="noopener">LinkedIn</a>
    <a class="secondary" href="/resume.pdf" download>Resume ↓</a>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: 12rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0;
    max-width: 18ch;
    color: var(--text);
  }

  .subline {
    color: var(--text-dim);
    max-width: 40ch;
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--bg);
    background: var(--accent);
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .cta:hover {
    background: var(--warm);
    transform: translateY(-2px);
  }

  .secondary {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    text-decoration: none;
    position: relative;
  }

  .secondary::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.25s ease;
  }

  .secondary:hover {
    color: var(--text);
  }

  .secondary:hover::after {
    width: 100%;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 0.5rem 0 0;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid rgba(94, 234, 212, 0.45);
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--accent);
  }

  .copy {
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(244, 241, 255, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copy-status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .contact {
      padding: 7rem 6vw;
      gap: 1.25rem;
    }
    .actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyStatus = document.querySelector<HTMLElement>('.contact .copy-status');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.copyEmail ?? '';
    let message = 'Copied';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      message = 'Press Ctrl+C to copy';
      const range = document.createRange();
      const link = document.querySelector('.contact .email');
      if (link) {
        range.selectNodeContents(link);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
      }
    }
    if (copyStatus) {
      copyStatus.textContent = message;
      window.setTimeout(() => { copyStatus.textContent = ''; }, 2500);
    }
  });
</script>

---
const stack = ['React.js', 'Next.js', 'Angular', 'Node.js', 'TypeScript', 'MongoDB'];
const orbits = ['a', 'b'];
// Short labels drawn from the skills on the resume.
const tags = [
  { id: 'one', label: 'React · Next.js' },
  { id: 'two', label: 'Node.js' },
  { id: 'three', label: 'LLM APIs' },
];
---
<section class="about" id="about">
    <h2 class="eyebrow"><span class="section-counter" data-count="03">00</span>About</h2>
  <div class="about-body">
  <div class="content">
    <p class="bio">
      I'm Ankit, a full-stack engineer with 3+ years of experience building
      responsive, high-performance web applications across financial
      analytics, automotive SaaS, enterprise productivity, and restaurant
      management.
    </p>
    <p class="bio">
      I work across React, Next.js, Angular, Node.js, and TypeScript, and
      integrate LLMs from Anthropic Claude, OpenAI, and Gemini. I own delivery
      timelines for 5+ concurrent client engagements, and I've been recognized
      for consistent on-time delivery.
    </p>
    <ul class="stack">
      {stack.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="portrait-stage" data-portrait>
    <div class="portrait-par">
      <div class="portrait-enter">
        <div class="portrait-float">
          <div class="portrait-card">
            {orbits.map((id) => <div class={`orbit orbit-${id} orbit-back`} aria-hidden="true"></div>)}
            <figure class="figure">
              <img
                src="/images/ankit-portrait.webp"
                alt="Portrait of Ankit Sinha"
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </figure>
            {orbits.map((id) => <div class={`orbit orbit-${id} orbit-front`} aria-hidden="true"></div>)}
            {tags.map((tag) => (
              <span class={`tag tag-${tag.id}`} aria-hidden="true"><i></i>{tag.label}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    overflow-x: clip;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 60ch) minmax(240px, 380px);
    grid-template-areas: 'text photo';
    justify-content: space-between;
    align-items: center;
    gap: 3rem 4rem;
  }

  .content {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }

  .bio {
    font-family: var(--font-body);
    color: var(--text);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    margin: 0;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  /*
   * ---- Portrait ----
   * No panel and no backdrop: the cut-out stands directly on the galaxy and dissolves into it.
   * Wrapper chain (each one owns a single transform so they never fight):
   *   par   = scroll glide      enter = slide-in      float = idle sway (touch)      card = cursor tilt
   * Every layer inside the card is a parallel plane, so depth sorting stays exact.
   */
  .portrait-stage {
    grid-area: photo;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    perspective: 1100px;
    perspective-origin: 50% 55%;
    --ring-a: 128%;
    --ring-b: 146%;
  }

  .portrait-par,
  .portrait-enter,
  .portrait-float,
  .portrait-card {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .portrait-par {
    transform: translate3d(calc(var(--gx, 0) * 34px), calc(var(--gy, 0) * 26px), 0);
  }

  .portrait-card {
    transform: rotateY(calc(var(--ry, 0) * 14deg)) rotateX(calc(var(--rx, 0) * -10deg));
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .figure {
    position: absolute;
    inset: 0;
    margin: 0;
    transform: translateZ(55px);
    /* soft vignette: hair and face stay solid, shoulders and base dissolve into the background */
    -webkit-mask-image: radial-gradient(ellipse 54% 60% at 50% 40%, #000 60%, transparent 100%);
    mask-image: radial-gradient(ellipse 54% 60% at 50% 40%, #000 60%, transparent 100%);
  }

  .figure img {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 26px rgba(94, 234, 212, 0.1));
  }

  /*
   * Orbit rings are flat ellipses drawn twice: the upper half sits behind the figure and the lower half
   * in front of it, so the ring appears to weave around the person.
   */
  .orbit {
    position: absolute;
    left: 50%;
    width: var(--orb-w);
    aspect-ratio: var(--orb-r);
    margin: calc(var(--orb-w) / var(--orb-r) / -2) 0 0 calc(var(--orb-w) / -2);
    border-radius: 50%;
    transform: translateZ(var(--oz)) scale(var(--os)) rotate(var(--tilt));
    pointer-events: none;
  }

  .orbit::before {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--orb-c);
    box-shadow: 0 0 14px var(--orb-c);
  }

  /* the dot rides the ellipse with a motion path (paint-only, no layout per frame) where supported */
  @supports (offset-path: ellipse(50% 50% at 50% 50%)) {
    .orbit::before {
      left: 0;
      top: 0;
      offset-path: ellipse(50% 50% at 50% 50%);
      offset-rotate: 0deg;
      offset-distance: 0%;
    }
  }

  .orbit-back {
    --oz: -40px;
    --os: 1.0364; /* (perspective + |z|) / perspective: cancels depth scaling so both halves meet */
    clip-path: inset(0 0 50% 0);
  }

  .orbit-front {
    --oz: 95px;
    --os: 0.9136;
    clip-path: inset(50% 0 0 0);
  }

  .orbit-a {
    --orb-w: var(--ring-a);
    --orb-r: 3.1;
    --tilt: -12deg;
    --orb-c: var(--accent);
    top: 57%;
    border: 1px solid rgba(94, 234, 212, 0.32);
  }

  .orbit-b {
    --orb-w: var(--ring-b);
    --orb-r: 3.9;
    --tilt: 9deg;
    --orb-c: var(--warm);
    top: 52%;
    border: 1px dashed rgba(255, 217, 160, 0.3);
  }

  /* floating labels: text only, no boxes, at different depths so the tilt gives them parallax */
  .tag {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    text-shadow: 0 0 14px rgba(7, 9, 15, 0.9), 0 1px 2px rgba(7, 9, 15, 0.8);
    pointer-events: none;
  }

  .tag i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .tag-one {
    top: 22%;
    left: -12%;
    transform: translateZ(130px);
  }

  .tag-two {
    top: 54%;
    right: -6%;
    transform: translateZ(150px);
  }

  .tag-three {
    top: 82%;
    left: 2%;
    transform: translateZ(110px);
  }

  .tag-two i {
    background: var(--warm);
    box-shadow: 0 0 10px var(--warm);
  }

  /* ---- Motion (all gated on reduced-motion; the script adds the js-* classes only when motion is allowed) ---- */

  /* slide-in: portrait glides in from the right, text from the left, labels last */
  .portrait-stage.js-slide .portrait-enter {
    opacity: 0;
    transform: translate3d(90px, 0, 0) rotateY(-14deg);
    transition:
      transform 1.15s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.9s ease;
  }

  .portrait-stage.js-slide.is-in .portrait-enter {
    opacity: 1;
    transform: none;
  }

  .portrait-stage.js-slide .tag {
    opacity: 0;
    translate: 46px 0;
    transition:
      opacity 0.7s ease,
      translate 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .portrait-stage.js-slide.is-in .tag {
    opacity: 1;
    translate: 0 0;
  }

  .portrait-stage.js-slide.is-in .tag-one { transition-delay: 0.55s; }
  .portrait-stage.js-slide.is-in .tag-two { transition-delay: 0.75s; }
  .portrait-stage.js-slide.is-in .tag-three { transition-delay: 0.95s; }

  .about-body.js-slide .content > * {
    opacity: 0;
    translate: -44px 0;
    transition:
      opacity 0.8s ease,
      translate 1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .about-body.js-slide.is-in .content > * {
    opacity: 1;
    translate: 0 0;
  }

  .about-body.js-slide.is-in .content > :nth-child(2) { transition-delay: 0.12s; }
  .about-body.js-slide.is-in .content > :nth-child(3) { transition-delay: 0.24s; }

  /* ambient: runs only while the portrait is on screen */
  @media (prefers-reduced-motion: no-preference) {
    .portrait-stage.is-live .orbit-a::before {
      animation: orbit-spin 14s linear infinite;
    }

    .portrait-stage.is-live .orbit-b::before {
      animation: orbit-spin 24s linear infinite reverse;
      animation-delay: -7s;
    }

    .portrait-stage.is-live .tag {
      animation: tag-bob 6s ease-in-out infinite alternate;
    }

    .portrait-stage.is-live .tag-two { animation-duration: 7.5s; animation-delay: -2s; }
    .portrait-stage.is-live .tag-three { animation-duration: 5.2s; animation-delay: -4s; }
  }

  /* with a mouse the card follows the cursor, so the idle sway is only for touch screens */
  @media (prefers-reduced-motion: no-preference) and (hover: none) {
    .portrait-stage.is-live .portrait-float {
      animation: portrait-sway 9s ease-in-out infinite alternate;
    }
  }

  @keyframes orbit-spin {
    to { offset-distance: 100%; }
  }

  @keyframes tag-bob {
    from { transform: translateZ(var(--tz, 130px)) translateY(-5px); }
    to { transform: translateZ(var(--tz, 130px)) translateY(6px); }
  }

  @keyframes portrait-sway {
    from { transform: translateY(0) rotateY(-5deg); }
    to { transform: translateY(-9px) rotateY(5deg); }
  }

  .tag-one { --tz: 130px; }
  .tag-two { --tz: 150px; }
  .tag-three { --tz: 110px; }

  /* narrower layouts: put the first label above the hair, where there is no room beside the head */
  @media (max-width: 1100px) {
    .tag-one { top: -3%; left: auto; right: -6%; }
  }

  @media (max-width: 860px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'photo' 'text';
      justify-content: stretch;
      justify-items: start;
    }

    .portrait-stage {
      width: min(66vw, 260px);
      justify-self: center;
      --ring-a: 124%;
      --ring-b: 140%;
    }

    .tag-two { right: -12%; }
    .tag-three { left: -2%; }

    /* on a phone the text slides up instead of in from the side, so nothing starts off-screen */
    .about-body.js-slide .content > * {
      translate: 0 28px;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding: 6rem 6vw;
      gap: 1.5rem;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-portrait]');
  const body = stage?.closest<HTMLElement>('.about-body');
  const section = stage?.closest<HTMLElement>('.about');

  if (stage && body && section) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const card = stage.querySelector<HTMLElement>('.portrait-card');
    const par = stage.querySelector<HTMLElement>('.portrait-par');
    const clamp = (v: number) => Math.min(1, Math.max(-1, v));
    const canObserve = typeof IntersectionObserver === 'function';

    // Slide-in entrance: arm the hidden state only when motion is allowed, then release on first sight.
    if (!reduce.matches && canObserve) {
      stage.classList.add('js-slide');
      body.classList.add('js-slide');
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          stage.classList.add('is-in');
          body.classList.add('is-in');
          observer.disconnect();
        },
        { threshold: 0.2 },
      ).observe(stage);
    }

    // Ambient motion and the scroll glide run only while the portrait is visible.
    let live = false;
    let scrollFrame = 0;
    const glide = () => {
      scrollFrame = 0;
      if (!par || reduce.matches) return;
      const rect = stage.getBoundingClientRect();
      const progress = clamp((rect.top + rect.height / 2 - window.innerHeight / 2) / (window.innerHeight * 0.6));
      par.style.setProperty('--gx', progress.toFixed(3));
      par.style.setProperty('--gy', (progress * -1).toFixed(3));
    };
    const onScroll = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(glide);
    };

    if (canObserve) {
      new IntersectionObserver(
        ([entry]) => {
          const visible = entry.isIntersecting;
          stage.classList.toggle('is-live', visible);
          if (visible && !live) {
            window.addEventListener('scroll', onScroll, { passive: true });
            glide();
          } else if (!visible && live) {
            window.removeEventListener('scroll', onScroll);
          }
          live = visible;
        },
        { threshold: 0.05 },
      ).observe(stage);
    }

    if (card) {
      let frame = 0;
      let nx = 0;
      let ny = 0;

      const paint = () => {
        frame = 0;
        card.style.setProperty('--ry', nx.toFixed(3));
        card.style.setProperty('--rx', ny.toFixed(3));
      };
      const schedule = () => {
        if (!frame) frame = window.requestAnimationFrame(paint);
      };

      // The portrait leans toward the cursor anywhere in the section, not only when hovered directly.
      section.addEventListener(
        'pointermove',
        (event) => {
          if (reduce.matches || !finePointer.matches || event.pointerType !== 'mouse') return;
          const rect = stage.getBoundingClientRect();
          nx = clamp((event.clientX - (rect.left + rect.width / 2)) / (window.innerWidth * 0.5));
          ny = clamp((event.clientY - (rect.top + rect.height / 2)) / (window.innerHeight * 0.5));
          schedule();
        },
        { passive: true },
      );
      section.addEventListener('pointerleave', () => {
        nx = 0;
        ny = 0;
        schedule();
      });
    }
  }
</script>

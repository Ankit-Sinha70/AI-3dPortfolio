---
import OptimizedImage from './OptimizedImage.astro';

const stack = ['Python', 'PyTorch', 'TypeScript', 'FastAPI', 'LangChain', 'Astro'];
---
<section class="about" id="about">
    <h2 class="eyebrow"><span class="section-counter" data-count="03">00</span>About</h2>
  <div class="about-body">
  <div class="content">
    <p class="bio">
      I'm Ankit, a generative AI engineer who ships systems, not just demos.
      My work spans text, image, and audio models — from fine-tuning and
      inference infrastructure to the product surface people actually touch.
    </p>
    <p class="bio">
      Before a model reaches a user, it goes through the unglamorous part:
      data pipelines, evaluation harnesses, latency budgets, and failure
      modes. That's the part I like most.
    </p>
    <ul class="stack">
      {stack.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <figure class="portrait">
    <OptimizedImage
      src="/images/ankit-profile.jpg"
      webp="/images/ankit-profile.webp"
      alt="Portrait of Ankit Sinha"
      width={720}
      height={900}
    />
  </figure>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 60ch) minmax(220px, 340px);
    grid-template-areas: 'text photo';
    justify-content: space-between;
    align-items: center;
    gap: 3rem 4rem;
  }

  .portrait {
    grid-area: photo;
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(94, 234, 212, 0.25);
    border-radius: 20px;
    overflow: hidden;
    background: rgba(244, 241, 255, 0.03);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45), 0 0 60px rgba(94, 234, 212, 0.06);
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 62%, rgba(7, 9, 15, 0.5));
  }

  .content {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }

  .bio {
    font-family: var(--font-body);
    color: var(--text);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    margin: 0;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .about-body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'photo' 'text';
      justify-content: stretch;
    }

    .portrait {
      width: min(72vw, 280px);
    }
  }

  @media (max-width: 640px) {
    .about {
      padding: 6rem 6vw;
      gap: 1.5rem;
    }
  }
</style>

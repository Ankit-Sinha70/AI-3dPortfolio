---
import { projects } from '../data/projects.js';
---
<section class="work" id="work">
  <h2 class="eyebrow"><span class="section-counter" data-count="02">00</span>Work</h2>
  <div class="grid">
    {projects.map((project) => (
      <article class="card">
        <h3>{project.title}</h3>
        <p class="desc">{project.description}</p>
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <a class="case-study-link" href={`/work/${project.slug}/`}>View case study →</a>
      </article>
    ))}
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    margin: 0;
    color: var(--text);
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  .case-study-link {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .case-study-link:hover {
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .work {
      padding: 6rem 6vw;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

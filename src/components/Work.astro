---
import { projects } from '../data/projects.js';

// Once the Work grid grows past this many cards, the rest collapse behind
// a "More work" toggle instead of the page growing unbounded. With the
// current 5 projects this stays under the threshold, so the button doesn't
// render yet -- future-proofing for when more projects are added.
const VISIBLE_COUNT = 6;
const hasOverflow = projects.length > VISIBLE_COUNT;
---
<section class="work" id="work">
  <h2 class="eyebrow"><span class="section-counter" data-count="02">00</span>Work</h2>
  <div class="grid" data-work-grid>
    {projects.map((project, i) => (
      <article class="card" data-extra={hasOverflow && i >= VISIBLE_COUNT ? 'true' : null}>
        <h3>{project.title}</h3>
        <p class="desc">{project.description}</p>
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
        <a class="case-study-link" href={`/work/${project.slug}/`}>View case study →</a>
      </article>
    ))}
  </div>
  {hasOverflow && (
    <button type="button" class="more-toggle" data-work-toggle aria-expanded="false">
      More work
    </button>
  )}
</section>

<style>
  .work {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .card[data-extra='true'] {
    display: none;
  }

  .grid.is-expanded .card[data-extra='true'] {
    display: flex;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    margin: 0;
    color: var(--text);
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  .case-study-link {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .case-study-link:hover {
    border-color: var(--accent);
  }

  .more-toggle {
    align-self: center;
    background: none;
    border: 1px solid rgba(244, 241, 255, 0.15);
    border-radius: 999px;
    padding: 0.65rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .more-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .work {
      padding: 6rem 6vw;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-work-toggle]');
  const grid = document.querySelector('[data-work-grid]');

  if (toggle && grid) {
    toggle.addEventListener('click', () => {
      const expanded = grid.classList.toggle('is-expanded');
      toggle.textContent = expanded ? 'Show less' : 'More work';
      toggle.setAttribute('aria-expanded', String(expanded));
    });
  }
</script>

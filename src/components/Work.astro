---
import { projects } from '../data/projects.js';
const VISIBLE_COUNT = 6;
const hasOverflow = projects.length > VISIBLE_COUNT;
---
<section class="work" id="work">
  <div class="work-heading"><h2 class="eyebrow"><span class="section-counter" data-count="02">00</span>Work</h2><p class="work-hint">The scene responds to the project in focus.</p></div>
  <div class="grid" data-work-grid>
    {projects.map((project, i) => (
      <article class="card" data-project={project.slug} data-project-index={i} data-extra={hasOverflow && i >= VISIBLE_COUNT ? 'true' : null}>
        <div class="card-top"><span class="project-index">0{i + 1}</span><span class="project-orbit" aria-hidden="true">↗</span></div>
        <h3>{project.title}</h3>
        <p class="desc">{project.description}</p>
        <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
        <a class="case-study-link" href={`/work/${project.slug}/`} aria-label={`View case study for ${project.title}`}>View case study <span>→</span></a>
      </article>
    ))}
  </div>
  {hasOverflow && <button type="button" class="more-toggle" data-work-toggle aria-expanded="false">More work</button>}
  <div class="work-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div>
</section>
<style>
.work{position:relative;padding:10rem 8vw;display:flex;flex-direction:column;gap:3rem;isolation:isolate;overflow:hidden}.work::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(7,9,15,.28),rgba(7,9,15,.08) 35%,rgba(7,9,15,.3));backdrop-filter:blur(12px) saturate(.82);-webkit-backdrop-filter:blur(12px) saturate(.82);pointer-events:none}.work-heading,.grid,.more-toggle{position:relative;z-index:2}.work-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem}.eyebrow{font-family:var(--font-mono);color:var(--accent);letter-spacing:.15em;text-transform:uppercase;font-size:.85rem;margin:0}.work-hint{font-family:var(--font-mono);font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim);margin:0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.25rem}.card{position:relative;border:1px solid rgba(244,241,255,.1);border-radius:10px;padding:1.75rem;min-height:310px;display:flex;flex-direction:column;gap:1rem;overflow:hidden;background:linear-gradient(145deg,rgba(18,24,34,.48),rgba(7,10,17,.34));box-shadow:inset 0 1px 0 rgba(255,255,255,.035),0 20px 70px rgba(0,0,0,.16);backdrop-filter:blur(16px) saturate(1.05);-webkit-backdrop-filter:blur(16px) saturate(1.05);transition:border-color .35s ease,transform .4s cubic-bezier(.22,1,.36,1),background .35s ease,box-shadow .4s ease}.card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 25% 110%,rgba(94,234,212,.1),transparent 42%);opacity:.55;pointer-events:none}.card>*{position:relative;z-index:1}.card[data-extra=true]{display:none}.grid.is-expanded .card[data-extra=true]{display:flex}.card-top{display:flex;align-items:center;justify-content:space-between}.project-index{font-family:var(--font-mono);font-size:.65rem;color:var(--text-dim);letter-spacing:.1em}.project-orbit{width:31px;height:31px;display:grid;place-items:center;border:1px solid rgba(244,241,255,.35);border-radius:50%;color:var(--text-dim);font-family:var(--font-mono);font-size:.85rem;transition:border-color .3s ease,color .3s ease,transform .3s ease}.card h3{font-family:var(--font-display);font-style:italic;font-weight:300;font-size:1.45rem;line-height:1.35;margin:.3rem 0 0;color:var(--text);max-width:16ch}.desc{color:#aaa7b9;font-size:.86rem;line-height:1.55;margin:0;max-width:32ch}.tags{display:flex;flex-wrap:wrap;gap:.6rem;list-style:none;margin:auto 0 0;padding:0}.tags li{font-family:var(--font-mono);font-size:.64rem;letter-spacing:.05em;color:var(--warm);text-transform:uppercase}.case-study-link{align-self:flex-start;font-family:var(--font-mono);font-size:.7rem;letter-spacing:.05em;color:var(--accent);text-decoration:none;border-bottom:1px solid transparent;transition:border-color .25s ease,transform .25s ease}.case-study-link span{display:inline-block;transition:transform .25s ease}.case-study-link:hover,.case-study-link:focus-visible{border-color:var(--accent)}.case-study-link:hover span,.case-study-link:focus-visible span{transform:translateX(4px)}.card:hover{border-color:rgba(94,234,212,.45);transform:translateY(-5px);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 26px 80px rgba(0,0,0,.28),0 0 34px rgba(94,234,212,.05)}.card:hover .project-orbit{border-color:var(--accent);color:var(--accent);transform:rotate(8deg)}.card[data-active-project]{border-color:rgba(94,234,212,.8);transform:translateY(-7px);background:linear-gradient(145deg,rgba(20,35,42,.68),rgba(8,13,20,.52));box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 26px 80px rgba(0,0,0,.32),0 0 34px rgba(94,234,212,.12)}.card[data-active-project]::before{opacity:1}.card[data-active-project] .project-index,.card[data-active-project] .project-orbit{color:var(--accent)}.card[data-active-project] .project-orbit{border-color:rgba(94,234,212,.7)}.more-toggle{align-self:center;background:rgba(7,9,15,.45);border:1px solid rgba(244,241,255,.15);border-radius:999px;padding:.65rem 1.75rem;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.05em;text-transform:uppercase;color:var(--text);cursor:pointer;transition:border-color .25s ease,color .25s ease}.more-toggle:hover{border-color:var(--accent);color:var(--accent)}.work-atmosphere{position:absolute;inset:10% 20%;z-index:0;pointer-events:none;filter:blur(55px);opacity:.38}.work-atmosphere span{position:absolute;width:180px;height:180px;border-radius:50%;background:rgba(94,234,212,.12)}.work-atmosphere span:nth-child(1){right:15%;top:8%}.work-atmosphere span:nth-child(2){right:40%;top:38%;background:rgba(139,124,255,.11)}.work-atmosphere span:nth-child(3){right:4%;bottom:4%;background:rgba(255,217,160,.08)}
@media(max-width:1100px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card{min-height:280px}}
@media(max-width:640px){.work{padding:6rem 6vw;gap:2rem}.work-heading{align-items:flex-start;flex-direction:column;gap:.75rem}.grid{grid-template-columns:1fr}.card{min-height:245px;padding:1.5rem}.work::before{backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)}}
@media(prefers-reduced-motion:reduce){.work::before{backdrop-filter:none;-webkit-backdrop-filter:none}.card{transition:none}}
</style>
<script>
const toggle=document.querySelector('[data-work-toggle]');const grid=document.querySelector('[data-work-grid]');
if(toggle&&grid){toggle.addEventListener('click',()=>{const expanded=grid.classList.toggle('is-expanded');toggle.textContent=expanded?'Show less':'More work';toggle.setAttribute('aria-expanded',String(expanded));});}
</script>

---
const projects = [
  {
    title: 'Aurora — Text-to-Image Pipeline',
    description: 'End-to-end diffusion pipeline with custom LoRA fine-tuning, queued inference, and a review UI for output curation.',
    tags: ['Diffusion', 'LoRA', 'FastAPI'],
  },
  {
    title: 'Echo — Voice Cloning Service',
    description: 'Low-latency voice synthesis service with speaker embedding cache and streaming playback.',
    tags: ['TTS', 'PyTorch', 'WebSockets'],
  },
  {
    title: 'Ledger — RAG Knowledge Assistant',
    description: 'Retrieval-augmented assistant over internal docs with hybrid search and citation-grounded answers.',
    tags: ['RAG', 'Vector DB', 'LangChain'],
  },
  {
    title: 'Drift — Agentic Workflow Runner',
    description: 'Multi-step agent orchestration with tool calling, retries, and human-in-the-loop checkpoints.',
    tags: ['Agents', 'Orchestration', 'TypeScript'],
  },
  {
    title: 'Halo — Generative Video Prototyping',
    description: 'Frame-consistent short-form video generation pipeline with prompt-driven storyboard control.',
    tags: ['Video Gen', 'Python', 'FFmpeg'],
  },
];
---
<section class="work" id="work">
   <h2 class="eyebrow"><span class="section-counter" data-count="02">00</span>Work</h2>
  <div class="grid">
    {projects.map((project) => (
      <article class="card">
        <h3>{project.title}</h3>
        <p class="desc">{project.description}</p>
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: 10rem 8vw;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.25s ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    margin: 0;
    color: var(--text);
  }

  .desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--warm);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .work {
      padding: 6rem 6vw;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

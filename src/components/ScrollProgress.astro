<div class="scroll-progress-rail" aria-hidden="true">
  <div class="scroll-progress-fill"></div>
</div>

<style>
  .scroll-progress-rail {
    position: fixed;
    top: 0;
    right: 0;
    width: 2px;
    height: 100vh;
    background: rgba(244, 241, 255, 0.08);
    z-index: 60;
  }

  .scroll-progress-fill {
    width: 100%;
    height: 0%;
    background: var(--accent);
    transform-origin: top;
  }

  @media (max-width: 640px) {
    .scroll-progress-rail {
      display: none;
    }
  }
</style>

---
// Lightweight CSS-only aurora wash behind the hero copy.
//
// This ships the "aurora" half of the week-3 backlog item
// ("3D hero scene -- aurora shader OR character variant"). The full
// WebGL/GLSL aurora shader (or a character variant) needs a local dev
// server to verify the rendered output before shipping blind, so that
// piece is descoped to a follow-up backlog line -- see docs/ISSUES_BACKLOG.md.
// This component is pure CSS (no WebGL, no JS), sits behind the existing
// particle field + line art, and is safe to verify from a screenshot alone.
---
<div class="aurora" aria-hidden="true"></div>

<style>
  .aurora {
    position: absolute;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 30% 20%, rgba(94, 234, 212, 0.22), transparent 60%),
      radial-gradient(ellipse 50% 35% at 75% 15%, rgba(255, 217, 160, 0.16), transparent 65%),
      radial-gradient(ellipse 45% 50% at 60% 60%, rgba(94, 234, 212, 0.1), transparent 70%);
    filter: blur(40px);
    opacity: 0.8;
    animation: aurora-drift 22s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  @keyframes aurora-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translate3d(-2%, 2%, 0) scale(1.06);
      opacity: 0.9;
    }
    100% {
      transform: translate3d(2%, -1%, 0) scale(1.02);
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora {
      animation: none;
      transform: none;
    }
  }
</style>

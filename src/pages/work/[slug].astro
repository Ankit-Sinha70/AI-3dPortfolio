---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const title = `${project.title} — Case Study — Ankit`;
const description = project.summary;
---
<Layout title={title} description={description}>
  <Nav />
  <main>
    <article class="case-study" data-case-study={project.slug}>
      <a class="back-link" href="/#work">&larr; Back to Work</a>
      <header class="case-header">
        <span class="section-counter">Case Study / {project.slug}</span>
        <h1>{project.title}</h1>
        <p class="role">{project.role}</p>
        <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
      </header>

      <div class="case-rail" aria-hidden="true"><span data-progress></span></div>
      <section class="block reveal"><span class="block-index">01</span><div><h2>Summary</h2><p>{project.summary}</p></div></section>
      <section class="block reveal"><span class="block-index">02</span><div><h2>The problem</h2><p>{project.problem}</p></div></section>
      <section class="block reveal"><span class="block-index">03</span><div><h2>Approach</h2><ol class="approach">{project.approach.map((step) => <li>{step}</li>)}</ol></div></section>
      <section class="block reveal"><span class="block-index">04</span><div><h2>Outcome</h2><p>{project.outcome}</p></div></section>

      <nav class="case-nav" aria-label="Case study navigation">
        <a href="/#work">← All work</a>
        <a href={`/#work?project=${project.slug}`}>Return to project scene →</a>
      </nav>
    </article>
  </main>
  <Footer />
</Layout>
<style>
.case-study{position:relative;max-width:980px;margin:0 auto;padding:10rem 6vw 8rem;display:flex;flex-direction:column;gap:5rem}.back-link,.case-nav a{font-family:var(--font-mono);font-size:.75rem;letter-spacing:.06em;color:var(--text-dim);text-decoration:none}.back-link:hover,.case-nav a:hover{color:var(--accent)}.case-header{max-width:820px;display:flex;flex-direction:column;gap:1rem}.case-header .section-counter{font-family:var(--font-mono);color:var(--warm);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase}.case-header h1{font-family:var(--font-display);font-style:italic;font-weight:300;font-size:clamp(3rem,8vw,7rem);line-height:.9;margin:0;color:var(--text)}.role{max-width:60ch;color:var(--text-dim);font-size:1rem;margin:0}.tags{display:flex;flex-wrap:wrap;gap:.6rem;list-style:none;margin:0;padding:0}.tags li{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.05em;color:var(--warm);text-transform:uppercase}.case-rail{position:fixed;right:2.5vw;top:20vh;height:60vh;width:1px;background:rgba(244,241,255,.1);z-index:5}.case-rail span{display:block;width:3px;transform:translateX(-1px);height:0;background:var(--accent);box-shadow:0 0 12px var(--accent)}.block{display:grid;grid-template-columns:4rem 1fr;gap:2rem;max-width:760px;padding-top:2rem;border-top:1px solid rgba(244,241,255,.08)}.block-index{font-family:var(--font-mono);font-size:.7rem;color:var(--accent);padding-top:.2rem}.block h2{font-family:var(--font-mono);color:var(--accent);letter-spacing:.1em;text-transform:uppercase;font-size:.8rem;margin:0 0 1rem}.block p,.approach li{color:var(--text-dim);font-size:1.05rem;line-height:1.8;margin:0}.approach{display:flex;flex-direction:column;gap:1rem;padding-left:1.25rem;margin:0}.approach li::marker{color:var(--accent)}.case-nav{display:flex;justify-content:space-between;gap:2rem;border-top:1px solid rgba(244,241,255,.08);padding-top:2rem}.reveal{opacity:0;transform:translateY(24px)}.js-ready .reveal{transition:opacity .7s ease,transform .7s ease}.js-ready .reveal.is-visible{opacity:1;transform:none}
@media(max-width:640px){.case-study{padding:7rem 6vw 5rem;gap:3.5rem}.case-rail{right:4vw;height:45vh;top:28vh}.block{grid-template-columns:2.5rem 1fr;gap:1rem}.block p,.approach li{font-size:1rem}.case-nav{flex-direction:column}.case-nav a:last-child{text-align:left}}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1!important;transform:none!important}.case-rail{display:none}}
</style>
<script>
document.documentElement.classList.add('js-ready');
const blocks=[...document.querySelectorAll('.reveal')];
if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>entry.target.classList.toggle('is-visible',entry.isIntersecting)),{threshold:.15});blocks.forEach(block=>observer.observe(block));}
const progress=document.querySelector('[data-progress]');
const updateProgress=()=>{if(!progress)return;const doc=document.documentElement;const max=doc.scrollHeight-window.innerHeight;progress.style.height=`${max>0?(window.scrollY/max)*100:0}%`;};
window.addEventListener('scroll',updateProgress,{passive:true});window.addEventListener('resize',updateProgress);updateProgress();
</script>

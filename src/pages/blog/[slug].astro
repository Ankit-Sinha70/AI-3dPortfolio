---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '../../data/posts.js';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.title} — Ankit`;

function formatDate(iso) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<Layout title={title} description={post.excerpt}>
  <Nav />
  <main>
    <article class="post">
      <a class="back-link" href="/blog/">&larr; Back to Writing</a>

      <header class="post-header">
        <span class="date">{formatDate(post.date)}</span>
        <h1>{post.title}</h1>
        <ul class="tags">
          {post.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </header>

      <div class="prose">
        {post.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <a class="back-link" href="/blog/">&larr; Back to Writing</a>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .post {
    max-width: 700px;
    margin: 0 auto;
    padding: 10rem 6vw 8rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    text-decoration: none;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--warm);
  }

  .post-header h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    margin: 0;
    color: var(--text);
    line-height: 1.25;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .prose p {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 640px) {
    .post {
      padding: 7rem 6vw 5rem;
      gap: 2.25rem;
    }
  }
</style>

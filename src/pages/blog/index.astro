---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { posts } from '../../data/posts.js';

const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));

function formatDate(iso) {
  return new Date(iso + 'T00:00:00').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<Layout title="Writing — Ankit" description="Notes on building generative AI systems in production.">
  <Nav />
  <main>
    <section class="blog-index" id="blog">
      <h1 class="eyebrow">Writing</h1>
      <p class="intro">Notes on building generative AI systems in production — what worked, what didn't, and why.</p>
      <div class="list">
        {sorted.map((post) => (
          <a class="post-row" href={`/blog/${post.slug}/`}>
            <span class="date">{formatDate(post.date)}</span>
            <span class="post-title">{post.title}</span>
            <p class="excerpt">{post.excerpt}</p>
            <ul class="tags">
              {post.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    max-width: 760px;
    margin: 0 auto;
    padding: 10rem 6vw 8rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0;
    color: var(--text);
  }

  .intro {
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    max-width: 56ch;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem;
    border: 1px solid rgba(244, 241, 255, 0.08);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.25s ease;
  }

  .post-row:hover {
    border-color: var(--accent);
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--warm);
  }

  .post-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.4rem;
    color: var(--text);
  }

  .excerpt {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .blog-index {
      padding: 7rem 6vw 5rem;
      gap: 2.25rem;
    }
  }
</style>
